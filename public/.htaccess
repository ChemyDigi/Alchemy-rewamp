# ── LiteSpeed / Apache Configuration for Alchemy Static Site ──
RewriteEngine On
RewriteBase /

# 1. Custom 404 Error Document (serves Next.js custom 404 page)
ErrorDocument 404 /404.html

# 2. Serve existing files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Handle URLs by serving index.html in corresponding directory
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)$ /$1/index.html [L]

# 4. Fallback for html files if requested without .html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ /$1.html [L]

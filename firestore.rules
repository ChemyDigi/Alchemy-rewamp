rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin email — store in Firestore as well for rules reference
    // OR use Firebase Auth UID approach (recommended below)

    // Helper: check if the requester is the admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'YOUR_ADMIN_EMAIL_HERE';
    }

    // ── Blogs ────────────────────────────────────────────────────────
    match /blogs/{blogId} {
      // Public can read published blogs only
      allow read: if resource.data.status == 'published' || isAdmin();
      // Only admin can write
      allow write: if isAdmin();
    }

    // ── Gallery ──────────────────────────────────────────────────────
    match /gallery/{itemId} {
      allow read: if true;       // Public gallery is readable
      allow write: if isAdmin();
    }

    // ── Team ─────────────────────────────────────────────────────────
    match /team/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Home Content ─────────────────────────────────────────────────
    match /homeContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Services ─────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
